# Скопируйте в .env (файл .env никогда не публикуйте и не добавляйте в git)
DATABASE_URL=postgres://user:password@localhost:5432/ortbit
# Длинная случайная строка, например: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
NODE_ENV=production
# За прокси хостинга (Render, Railway, Fly и т.п.) поставьте 1
TRUST_PROXY=
# 1, если база требует SSL (Supabase, Neon и др.)
PGSSL=
# Владелец платформы. Пароль впишите только в свой приватный .env, а после первого запуска удалите эту строку
ADMIN_USERNAME=Sultan
ADMIN_PASSWORD=
